          },
          "editorMode": "code",
          "expr": "sum(rate(orders_processed_total{result=\"success\"}[1m]))",
          "legendFormat": "Orders Succeeded / sec",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(orders_processed_total{result=\"failed\"}[1m]))",
