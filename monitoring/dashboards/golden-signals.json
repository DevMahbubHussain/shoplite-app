        "x": 12,
        "y": 18
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": ["mean", "lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "title": "7. Business Throughput - Orders Created vs Processed",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
