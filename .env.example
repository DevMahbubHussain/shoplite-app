# Database Configuration
POSTGRES_DB=shoplite_db
POSTGRES_USER=shoplite_user
POSTGRES_PASSWORD=shoplite_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://shoplite_user:shoplite_password@localhost:5432/shoplite_db

# Redis Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Service & Logging
LOG_LEVEL=INFO
SERVICE_NAME=catalog-api

# OpenTelemetry & Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=catalog-api
OTEL_TRACES_EXPORTER=none

# Chaos Engineering Flags (default: disabled)
CHAOS_LATENCY_MS=0
CHAOS_ERROR_RATE=0.0
CHAOS_SLOW_DB=false
CHAOS_MEMORY_LEAK=false
