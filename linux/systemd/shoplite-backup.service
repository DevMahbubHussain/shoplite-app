[Unit]
Description=ShopLite Nightly PostgreSQL Database Backup Service
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Restart=on-failure
RestartSec=30s
ExecStart=/usr/local/bin/shoplite-backup.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
